# Local: http://localhost:3000; run setup in the browser on this computer.
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
DATA_DIR=./data
# Required for initial setup on a VPS. Generate: openssl rand -hex 24
SETUP_KEY=
# Public HTTPS origin on a VPS, e.g. https://bilder.example.at
PUBLIC_ORIGIN=
# Production behind the supplied Caddy proxy:
TRUST_PROXY=false
COOKIE_SECURE=false
MAX_STORAGE_MB=1024
# Used only with a new database; later edits are made in the admin area.
ORGANIZATION_PRESET=neutral
# Used by compose.prod.yaml; point DNS to the server first.
DOMAIN=
# Optional Chromium executable for the WhatsApp connection.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
